root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 100
ktlint_code_style = intellij_idea
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# The harness is a Kotlin source template held in a raw string; its inner
# formatting is deliberate and not ktlint's business.
ktlint_standard_string-template-indent = disabled

[*.{yml,yaml,xml}]
indent_size = 2
